NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/tts?schema=public
# Supabase: use the Session pooler (IPv4); the direct db.<ref>.supabase.co host is IPv6-only
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
# Connections per process; use ~3 on Vercel, where many instances can run
DATABASE_POOL_MAX=10
# Port for the API (most hosts set it; Vercel uses 80 unless the project sets PORT)
PORT=8000

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_PASS_RESET_SECRET=

# Gmail SMTP: SMTP_PASS is a Google App Password (not your account password).
# Leave SMTP_PASS empty in development to print emails (OTP codes) to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM="TTS <you@gmail.com>"

# Google sign-in: the *Web application* OAuth client ID (the Android app uses it
# as serverClientId so ID tokens are issued for this audience). Empty = disabled.
GOOGLE_CLIENT_ID=

# Public base URL of this API (used in signed audio/file links). From a phone over USB
# with `adb reverse tcp:8000 tcp:8000`, localhost works.
PUBLIC_URL=http://localhost:8000

# OpenRouter: speech (TTS) and OCR. Without a key, development uses a free mock voice.
OPENROUTER_API_KEY=
# TTS_PROVIDER=openrouter|mock   (defaults to openrouter when a key is set)
TTS_MODEL_STANDARD=hexgrad/kokoro-82m
TTS_MODEL_MULTILINGUAL=google/gemini-3.8-flash-lite-tts
OPENROUTER_OCR_MODEL=google/gemini-2.5-flash-lite

# File storage: local disk in development, S3-compatible (e.g. Cloudflare R2) in production
# "local" keeps files on disk; "s3" uses any S3-compatible bucket, e.g. Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
#   keys from an R2 API token with Object Read & Write on the bucket.
# Moving from local to a bucket: set these, then run `pnpm storage:copy-to-bucket` once.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_UPLOAD_MB=25
# Free tier: characters sent to the speech provider per user per month
FREE_TIER_MONTHLY_CHARS=300000
# Run background workers (imports, AI emotions, MP3 exports, account purge) in this process.
# Local dev: true. Vercel API: false, with one always-on `node dist/worker.js` elsewhere.
RUN_WORKERS=true
