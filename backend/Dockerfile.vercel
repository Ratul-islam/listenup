# syntax=docker/dockerfile:1
#
# The API on Vercel Functions (Vercel builds this file name automatically).
# Same image as ./Dockerfile, with the API defaults Vercel needs; keep the
# build stages in sync. Set RUN_WORKERS=false in the Vercel project: an
# always-on worker elsewhere (./Dockerfile, `node dist/worker.js`) runs the jobs.

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@12.8.1 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# The generated client only loads the PostgreSQL query compiler ("fast" build);
# drop the other databases' compilers and source maps (~55 MB)
RUN pnpm install --frozen-lockfile --prod \
 && cd node_modules/@prisma/client/runtime \
 && rm -f *sqlserver* *cockroachdb* *mysql* *sqlite* query_compiler_small_bg.* *.map

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY prisma.config.ts tsconfig.json ./
COPY prisma ./prisma
COPY src ./src
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build pnpm run build

FROM node:22-alpine AS runtime
# Package managers aren't needed to run the app
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn*
# Vercel sends traffic to port 80 unless the project sets PORT; binding 80 needs root,
# which is fine inside Vercel's isolated function sandbox.
ENV NODE_ENV=production \
    PORT=80 \
    RUN_WORKERS=false \
    DATABASE_POOL_MAX=3
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
CMD ["node", "dist/server.js"]
