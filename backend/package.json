{
  "name": "tts-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "storage:copy-to-bucket": "tsx src/scripts/copy-local-storage.ts",
    "user:set-plan": "tsx src/scripts/set-plan.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@breezystack/lamejs": "^1.2.7",
    "@fastify/autoload": "^6.5.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "music-metadata": "^11.16.1",
    "node-html-parser": "^9.0.4",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
