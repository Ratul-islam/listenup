# No secrets in this file. EXPO_PUBLIC_ values are built into the app for anyone to read,
# and Expo copies every value here into .expo/dev/logs. API keys belong in backend/.env.

# Backend base URL, including the /api/v1 prefix.
#   Android emulator -> http://10.0.2.2:8000/api/v1
#   Physical device  -> http://<your computer's LAN IP>:8000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# The *Web application* OAuth client ID (same value as the backend's GOOGLE_CLIENT_ID).
# Leave empty to hide "Continue with Google".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat's public Google Play API key (Project settings > API keys). Leave empty to
# keep plans as "Available soon".
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=

# AdMob ad unit ids (AdMob > Apps > Ad units). Leave empty in development to show Google's
# test ads; release builds without them show no ads. The AdMob app id goes in app.json.
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=

# Crash reports go to ListenUp's Sentry project (its DSN is in src/lib/crash-reports.ts); development
# builds never send them. Uncomment to send them elsewhere, or set it empty to send none.
# Release builds also need SENTRY_AUTH_TOKEN to upload source maps (see RELEASE.md), or
# SENTRY_DISABLE_AUTO_UPLOAD=true to skip that.
# EXPO_PUBLIC_SENTRY_DSN=
