# Backend base URL, including the /api/v1 prefix.
#   Android emulator -> http://10.0.2.2:8000/api/v1
#   Physical device  -> http://<your computer's LAN IP>:8000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# The *Web application* OAuth client ID (same value as the backend's GOOGLE_CLIENT_ID).
# Leave empty to hide "Continue with Google".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
