{
  "expo": {
    "name": "ListenUp",
    "slug": "listenup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "listenup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.ratul.tts"
    },
    "android": {
      "package": "dev.ratul.tts",
      "adaptiveIcon": {
        "backgroundColor": "#EEF0FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0F1024",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Plus Jakarta Sans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlusJakartaSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/PlusJakartaSans_400Regular.ttf",
              "./assets/fonts/PlusJakartaSans_500Medium.ttf",
              "./assets/fonts/PlusJakartaSans_600SemiBold.ttf",
              "./assets/fonts/PlusJakartaSans_700Bold.ttf",
              "./assets/fonts/PlusJakartaSans_800ExtraBold.ttf",
              "./assets/fonts/JetBrainsMono_500Medium.ttf",
              "./assets/fonts/JetBrainsMono_600SemiBold.ttf"
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ListenUp uses the microphone to record your voice for cloning.",
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ListenUp reads text from photos you choose.",
          "cameraPermission": "ListenUp reads text from pages you photograph.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-asset",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "text/markdown",
              "application/pdf",
              "application/epub+zip",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "image/*"
            ],
            "multipleShareMimeTypes": [
              "image/*"
            ]
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidSdk": "classic"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
